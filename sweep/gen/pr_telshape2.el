(require 'org-element)
(defun pr-tel-p (line)
  (with-temp-buffer
    (set-buffer-multibyte t)
    (insert line "\n" line "\n")
    (let ((org-inhibit-startup t)) (org-mode))
    (let (found)
      (org-element-map (org-element-parse-buffer) 'table
        (lambda (n) (when (eq (org-element-property :type n) 'table.el) (setq found t))))
      found)))
(let ((alpha '(?+ ?- ?= ?\s ?\t)) (yes '()))
  (cl-labels ((gen (p d)
                (when (> (length p) 0) (when (pr-tel-p p) (push p yes)))
                (when (< d 5) (dolist (c alpha) (gen (concat p (char-to-string c)) (1+ d))))))
    (gen "" 0))
  (setq yes (nreverse yes))
  (princ (format "THE %d SHAPES THAT FORM A table.el:\n" (length yes)))
  (dolist (s yes) (princ (format "   %S\n" s)))
  ;; Candidate corrected pattern: leading blanks, then `+`, then one or more
  ;; RUNS of `-` each terminated by a single `+`, then trailing blanks.
  (let ((re2 "\\`[ \t]*\\(\\+-+\\)+\\+?[ \t]*\\'")
        (re3 "\\`[ \t]*\\+\\(-+\\+\\)+[ \t]*\\'")
        fp2 fn2 fp3 fn3)
    (cl-labels ((chk (p d)
                  (when (> (length p) 0)
                    (let ((a (and (member p yes) t)))
                      (let ((b (and (string-match-p re2 p) t))) (cond ((and b (not a)) (push p fp2)) ((and a (not b)) (push p fn2))))
                      (let ((b (and (string-match-p re3 p) t))) (cond ((and b (not a)) (push p fp3)) ((and a (not b)) (push p fn3))))))
                  (when (< d 5) (dolist (c alpha) (chk (concat p (char-to-string c)) (1+ d))))))
      (chk "" 0))
    (princ (format "\nCANDIDATE A  %s\n   false-pos %d %S   false-neg %d %S\n" re2 (length fp2) (last fp2 5) (length fn2) (last fn2 5)))
    (princ (format "CANDIDATE B  %s\n   false-pos %d %S   false-neg %d %S\n" re3 (length fp3) (last fp3 5) (length fn3) (last fn3 5)))))
